# Example secrets file
# DO NOT commit this file with actual secrets!
# This is a template showing the structure
#
# To create actual secrets file:
# 1. Copy this to secrets.yaml: cp secrets.yaml.example secrets.yaml
# 2. Fill in actual values
# 3. Encrypt with sops: sops -e secrets.yaml > secrets.yaml.enc
# 4. Replace secrets.yaml with secrets.yaml.enc: mv secrets.yaml.enc secrets.yaml
# 5. Commit encrypted secrets.yaml to git
#
# To edit encrypted secrets:
#   sops secrets/secrets.yaml

# Democratic CSI SSH private key
# Generate with: ssh-keygen -t ed25519 -C "democratic-csi" -f democratic-csi
democratic-csi:
  ssh-private-key: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
    ... (paste your actual private key here) ...
    -----END OPENSSH PRIVATE KEY-----

# K3s agent tokens
# Get from mainframe: sudo cat /var/lib/rancher/k3s/server/node-token
k3s:
  agent-token-jarvis: "K10abcdef1234567890::server:abcdef1234567890"
  agent-token-akasha: "K10abcdef1234567890::server:abcdef1234567890"

# Example: Future secrets
# example:
#   api-token: "secret-api-token-value"
#   certificate: |
#     -----BEGIN CERTIFICATE-----
#     ...
#     -----END CERTIFICATE-----
